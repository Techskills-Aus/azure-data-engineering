<mxfile host="app.diagrams.net"><diagram name="Order fulfillment" id="order-fulfillment"><mxGraphModel page="1" pageWidth="850" pageHeight="420"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Data Sources, Formats and APIs Architecture" style="text;align=left;fontSize=24;fontStyle=1;fontColor=#163A63" vertex="1" parent="1"><mxGeometry as="geometry" x="28" y="30" width="745" height="44" /></mxCell><mxCell id="s0" value="&lt;b&gt;Source feeds&lt;/b&gt;&lt;br&gt;ERP SQL, warehouse CSV, carrier API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FC;fontColor=#163A63;strokeColor=#163A63" vertex="1" parent="1"><mxGeometry as="geometry" x="28" y="140" width="165" height="55" /></mxCell><mxCell id="s1" value="&lt;b&gt;Raw landing&lt;/b&gt;&lt;br&gt;Preserve original payload and identity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FC;fontColor=#163A63;strokeColor=#163A63" vertex="1" parent="1"><mxGeometry as="geometry" x="214" y="140" width="165" height="55" /></mxCell><mxCell id="e1" edge="1" parent="1" source="s0" target="s1" style="endArrow=block;strokeWidth=2;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s2" value="&lt;b&gt;Validation&lt;/b&gt;&lt;br&gt;Parse, reconcile and quarantine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FC;fontColor=#163A63;strokeColor=#163A63" vertex="1" parent="1"><mxGeometry as="geometry" x="400" y="140" width="165" height="55" /></mxCell><mxCell id="e2" edge="1" parent="1" source="s1" target="s2" style="endArrow=block;strokeWidth=2;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s3" value="&lt;b&gt;Typed outputs&lt;/b&gt;&lt;br&gt;Order lines and shipment events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FC;fontColor=#163A63;strokeColor=#163A63" vertex="1" parent="1"><mxGeometry as="geometry" x="586" y="140" width="165" height="55" /></mxCell><mxCell id="e3" edge="1" parent="1" source="s2" target="s3" style="endArrow=block;strokeWidth=