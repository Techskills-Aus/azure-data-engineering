<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="24.7.17" type="device"><diagram id="ARCH-001" name="Data engineering: complete lifecycle"><mxGraphModel dx="1250" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="650"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="ARCH-001-node-00" value="&lt;b&gt;Business outcome&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Revenue, availability, customer experience&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#137FC2;strokeColor=#1A3850;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;align=center;verticalAlign=middle;spacing=9;shadow=0;" vertex="1" parent="1"><mxGeometry x="75" y="135" width="205" height="105" as="geometry" /></mxCell><mxCell id="ARCH-001-node-01" value="&lt;b&gt;Operational sources&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;ERP • CRM • POS • APIs • events&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#137FC2;strokeColor=#1A3850;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;align=center;verticalAlign=middle;spacing=9;shadow=0;" vertex="1" parent="1"><mxGeometry x="320" y="135" width="205" height="105" as="geometry" /></mxCell><mxCell id="ARCH-001-node-02" value="&lt;b&gt;Ingestion&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Batch • CDC • streaming&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#087F83;strokeColor=#1A3850;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;align=center;verticalAlign=middle;spacing=9;shadow=0;" vertex="1" parent="1"><mxGeometry x="565" y="135" width="205" height="105" as="geometry" /></mxCell><mxCell id="ARCH-001-node-03" value="&lt;b&gt;Raw landing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Immutable history • replay • audit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5A63B7;strokeColor=#1A3850;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;align=center;verticalAlign=middle;spacing=9;shadow=0;" vertex="1" parent="1"><mxGeometry x="810" y="135" width="205" height="105" as="geometry" /></mxCell><mxCell id="ARCH-001-node-04" value="&lt;b&gt;Quality gates&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Schema • nulls • duplicates • timeliness&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C07D21;strokeColor=#1A3850;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;align=center;verticalAlign=middle;spacing=9;shadow=0;" vertex="1" parent="1"><mxGeometry x="75" y="330" width="205" height="105" as="geometry" /></mxCell><mxCell id="ARCH-001-node-05" value="&lt;b&gt;Transformation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Clean • standardize • enrich • join&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#087F83;strokeColor=#1A3850;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;align=center;verticalAlign=middle;spacing=9;shadow=0;" vertex="1" parent="1"><mxGeometry x="320" y="330" width="205" height="105" as="geometry" /></mxCell><mxCell id="ARCH-001-node-06" value="&lt;b&gt;Curated models&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Facts • dimensions • metrics&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5A63B7;strokeColor=#1A3850;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;align=center;verticalAlign=middle;spacing=9;shadow=0;" vertex="1" parent="1"><mxGeometry x="565" y="330" width="205" height="105" as="geometry" /></mxCell><mxCell id="ARCH-001-node-07" value="&lt;b&gt;Consumption&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;BI • analytics • ML • APIs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#087F83;strokeColor=#1A3850;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;align=center;verticalAlign=middle;spacing=9;shadow=0;" vertex="1" parent="1"><mxGeometry x="810" y="330" width="205" height="105" as="geometry" /></mxCell><mxCell id="ARCH-001-flow-00" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#183A55;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="ARCH-001-node-00" target="ARCH-001-node-01"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ARCH-001-flow-01" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#183A55;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="ARCH-001-node-01" target="ARCH-001-node-02"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ARCH-001-flow-02" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#183A55;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="ARCH-001-node-02" target="ARCH-001-node-03"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ARCH-001-flow-03" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#183A55;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="ARCH-001-node-03" target="ARCH-001-node-04"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ARCH-001-flow-04" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#183A55;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="ARCH-001-node-04" target="ARCH-001-node-05"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ARCH-001-flow-05" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#183A55;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="ARCH-001-node-05" target="ARCH-001-node-06"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ARCH-001-flow-06" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#183A55;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="ARCH-001-node-06" target="ARCH-001-node-07"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="ARCH-002" name="ETL and ELT: where transformation runs"><mxGraphModel dx="1250" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="650"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="ARCH-002-node-00" value="&lt;b&gt;Source systems&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;SQL • ERP • APIs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#137FC2;strokeColor=#1A3850;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;align=center;verticalAlign=middle;spacing=9;shadow=0;" vertex="1" parent="1"><mxGeometry x="75" y="125" width="205" height="105" as="geometry" /></mxCell><mxCell id="ARCH-002-node-01" value="&lt;b&gt;ETL: extract&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Pull source records&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#087F83;strokeColor=#1A3850;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;align=center;verticalAlign=middle;spacing=9;shadow=0;" vertex="1" parent="1"><mxGeometry x="320" y="125" width="205" height="105" as="geometry" /></mxCell><mxCell id="ARCH-002-node-02" value="&lt;b&gt;ETL: transform&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Dedicated processing engine&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#087F83;strokeColor=#1A3850;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;align=center;verticalAlign=middle;spacing=9;shadow=0;" vertex="1" parent="1"><mxGeometry x="565" y="125" width="205" height="105" as="geometry" /></mxCell><mxCell id="ARCH-002-node-03" value="&lt;b&gt;ETL: load&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Publish modeled warehouse data&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5A63B7;strokeColor=#1A3850;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;align=center;verticalAlign=middle;spacing=9;shadow=0;" vertex="1" parent="1"><mxGeometry x="810" y="125" width="205" height="105" as="geometry" /></mxCell><mxCell id="ARCH-002-node-04" value="&lt;b&gt;Source systems&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;SQL • ERP • APIs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#137FC2;strokeColor=#1A3850;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;align=center;verticalAlign=middle;spacing=9;shadow=0;" vertex="1" parent="1"><mxGeometry x="75" y="375" width="205" height="105" as="geometry" /></mxCell><mxCell id="ARCH-002-node-05" value="&lt;b&gt;ELT: extract&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Capture original records&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#087F83;strokeColor=#1A3850;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;align=center;verticalAlign=middle;spacing=9;shadow=0;" vertex="1" parent="1"><mxGeometry x="320" y="375" width="205" height="105" as="geometry" /></mxCell><mxCell id="ARCH-002-node-06" value="&lt;b&gt;ELT: load&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Land in cloud warehouse/lake&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5A63B7;strokeColor=#1A3850;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;align=center;verticalAlign=middle;spacing=9;shadow=0;" vertex="1" parent="1"><mxGeometry x="565" y="375" width="205" height="105" as="geometry" /></mxCell><mxCell id="ARCH-002-node-07" value="&lt;b&gt;ELT: transform&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Use target compute to model&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#087F83;strokeColor=#1A3850;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;align=center;verticalAlign=middle;spacing=9;shadow=0;" vertex="1" parent="1"><mxGeometry x="810" y="375" width="205" height="105" as="geometry" /></mxCell><mxCell id="ARCH-002-flow-00" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#183A55;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="ARCH-002-node-00" target="ARCH-002-node-01"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ARCH-002-flow-01" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#183A55;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="ARCH-002-node-01" target="ARCH-002-node-02"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ARCH-002-flow-02" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#183A55;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="ARCH-002-node-02" target="ARCH-002-node-03"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ARCH-002-flow-03" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#183A55;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="ARCH-002-node-04" target="ARCH-002-node-05"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ARCH-002-flow-04" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#183A55;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="ARCH-002-node-05" target="ARCH-002-node-06"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ARCH-002-flow-05" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#183A55;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="ARCH-002-node-06" target="ARCH-002-node-07"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="ARCH-003" name="Batch, streaming and CDC patterns"><mxGraphModel dx="1250" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="650"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="ARCH-003-node-00" value="&lt;b&gt;Scheduled batch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Daily/hourly files or queries&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#137FC2;strokeColor=#1A3850;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;align=center;verticalAlign=middle;spacing=9;shadow=0;" vertex="1" parent="1"><mxGeometry x="75" y="125" width="205" height="105" as="geometry" /></mxCell><mxCell id="ARCH-003-node-01" value="&lt;b&gt;Batch pipeline&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Windowed extraction&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#087F83;strokeColor=#1A3850;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;align=center;verticalAlign=middle;spacing=9;shadow=0;" vertex="1" parent="1"><mxGeometry x="400" y="125" width="205" height="105" as="geometry" /></mxCell><mxCell id="ARCH-003-node-02" value="&lt;b&gt;Landing table&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Bounded dataset&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5A63B7;strokeColor=#1A3850;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;align=center;verticalAlign=middle;spacing=9;shadow=0;" vertex="1" parent="1"><mxGeometry x="725" y="125" width="205" height="105" as="geometry" /></mxCell><mxCell id="ARCH-003-node-03" value="&lt;b&gt;Event producers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Application telemetry • clicks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#137FC2;strokeColor=#1A3850;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;align=center;verticalAlign=middle;spacing=9;shadow=0;" vertex="1" parent="1"><mxGeometry x="75" y="275" width="205" height="105" as="geometry" /></mxCell><mxCell id="ARCH-003-node-04" value="&lt;b&gt;Event broker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Buffered event stream&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#087F83;strokeColor=#1A3850;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;align=center;verticalAlign=middle;spacing=9;shadow=0;" vertex="1" parent="1"><mxGeometry x="400" y="275" width="205" height="105" as="geometry" /></mxCell><mxCell id="ARCH-003-node-05" value="&lt;b&gt;Stream processing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Continuous or micro-batch&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5A63B7;strokeColor=#1A3850;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;align=center;verticalAlign=middle;spacing=9;shadow=0;" vertex="1" parent="1"><mxGeometry x="725" y="275" width="205" height="105" as="geometry" /></mxCell><mxCell id="ARCH-003-node-06" value="&lt;b&gt;OLTP database&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Inserts • updates • deletes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#137FC2;strokeColor=#1A3850;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;align=center;verticalAlign=middle;spacing=9;shadow=0;" vertex="1" parent="1"><mxGeometry x="75" y="425" width="205" height="105" as="geometry" /></mxCell><mxCell id="ARCH-003-node-07" value="&lt;b&gt;Change log / CDC&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Ordered changes + offsets&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#087F83;strokeColor=#1A3850;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;align=center;verticalAlign=middle;spacing=9;shadow=0;" vertex="1" parent="1"><mxGeometry x="400" y="425" width="205" height="105" as="geometry" /></mxCell><mxCell id="ARCH-003-node-08" value="&lt;b&gt;Incremental target&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Merge • deduplicate • replay&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5A63B7;strokeColor=#1A3850;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;align=center;verticalAlign=middle;spacing=9;shadow=0;" vertex="1" parent="1"><mxGeometry x="725" y="425" width="205" height="105" as="geometry" /></mxCell><mxCell id="ARCH-003-flow-00" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#183A55;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="ARCH-003-node-00" target="ARCH-003-node-01"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ARCH-003-flow-01" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#183A55;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="ARCH-003-node-01" target="ARCH-003-node-02"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ARCH-003-flow-02" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#183A55;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="ARCH-003-node-03" target="ARCH-003-node-04"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ARCH-003-flow-03" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#183A55;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="ARCH-003-node-04" target="ARCH-003-node-05"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ARCH-003-flow-04" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#183A55;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="ARCH-003-node-06" target="ARCH-003-node-07"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ARCH-003-flow-05" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#183A55;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="ARCH-003-node-07" target="ARCH-003-node-08"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="ARCH-004" name="Azure retail analytics pipeline"><mxGraphModel dx="1250" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="650"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Azure retail analytics pipeline" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontColor=#183A55;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="24" width="1050" height="32" /></mxCell><mxCell id="subtitle" value="ARCH-004  |  Follow stages 1–4 left to right, then stages 5–8 right to left." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#000000;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="62" width="1050" height="23" /></mxCell><mxCell id="stage-0" value="&lt;b&gt;1. SQL Server / ERP&lt;/b&gt;&lt;br&gt;Owns transaction keys, versions and business timestamps. Exposes a bounded range of order changes." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=11;fillColor=#EFF5FA;strokeColor=#7495AE;fontColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="120" width="240" height="116" /></mxCell><mxCell id="stage-1" value="&lt;b&gt;2. Azure Data Factory&lt;/b&gt;&lt;br&gt;Copies the bounded range into a batch folder. Records source bounds and confirms the extract is complete." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=11;fillColor=#EFF5FA;strokeColor=#7495AE;fontColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="305" y="120" width="240" height="116" /></mxCell><mxCell id="stage-2" value="&lt;b&gt;3. ADLS Gen2 · Bronze&lt;/b&gt;&lt;br&gt;Retains original extracts and a batch manifest. Databricks reads only complete batches and can replay them." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=11;fillColor=#EFF5FA;strokeColor=#7495AE;fontColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="575" y="120" width="240" height="116" /></mxCell><mxCell id="stage-3" value="&lt;b&gt;4. Azure Databricks&lt;/b&gt;&lt;br&gt;Checks schema and keys, normalizes amounts and timestamps, and quarantines conflicting records." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=11;fillColor=#EFF5FA;strokeColor=#7495AE;fontColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="845" y="120" width="240" height="116" /></mxCell><mxCell id="stage-4" value="&lt;b&gt;5. Silver Delta tables&lt;/b&gt;&lt;br&gt;Stores conformed order lines at the agreed grain. A version-aware merge makes repeated delivery safe." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=11;fillColor=#EFF5FA;strokeColor=#7495AE;fontColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="845" y="300" width="240" height="116" /></mxCell><mxCell id="stage-5" value="&lt;b&gt;6. Gold Delta tables&lt;/b&gt;&lt;br&gt;Builds the sales fact and dimensions, reconciles totals, and exposes the last accepted publication." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=11;fillColor=#EFF5FA;strokeColor=#7495AE;fontColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="575" y="300" width="240" height="116" /></mxCell><mxCell id="stage-6" value="&lt;b&gt;7. Databricks SQL&lt;/b&gt;&lt;br&gt;A SQL warehouse reads published Gold tables and enforces permissions for the serving identity." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=11;fillColor=#EFF5FA;strokeColor=#7495AE;fontColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="305" y="300" width="240" height="116" /></mxCell><mxCell id="stage-7" value="&lt;b&gt;8. Power BI&lt;/b&gt;&lt;br&gt;The semantic model refreshes after acceptance, defines sales measures and shows the published-through date." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=11;fillColor=#EFF5FA;strokeColor=#7495AE;fontColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="300" width="240" height="116" /></mxCell><mxCell id="flow-0" edge="1" parent="1" source="stage-0" target="stage-1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#183A55;strokeWidth=3;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="flow-1" edge="1" parent="1" source="stage-1" target="stage-2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#183A55;strokeWidth=3;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="flow-2" edge="1" parent="1" source="stage-2" target="stage-3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#183A55;strokeWidth=3;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="flow-3" edge="1" parent="1" source="stage-3" target="stage-4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#183A55;strokeWidth=3;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="flow-4" edge="1" parent="1" source="stage-4" target="stage-5" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#183A55;strokeWidth=3;endArrow=block;exitX=0;exitY=0.5;entryX=1;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="flow-5" edge="1" parent="1" source="stage-5" target="stage-6" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#183A55;strokeWidth=3;endArrow=block;exitX=0;exitY=0.5;entryX=1;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="flow-6" edge="1" parent="1" source="stage-6" target="stage-7" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#183A55;strokeWidth=3;endArrow=block;exitX=0;exitY=0.5;entryX=1;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="control-0" value="&lt;b&gt;Publication and recovery&lt;/b&gt;&lt;br&gt;Land a complete manifest before starting validation. When reconciliation fails, quarantine the affected records and keep the previous Gold publication available. On retry, reuse the original batch and reconcile publication state before advancing the checkpoint." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=11;fillColor=#FFFFFF;strokeColor=#7495AE;fontColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="460" width="510" height="120" /></mxCell><mxCell id="control-1" value="&lt;b&gt;Monitoring and access&lt;/b&gt;&lt;br&gt;Azure Monitor receives configured diagnostics and alerts. Track source coverage, job errors, rejects and freshness. Scope source, landing, processing and serving permissions by identity and log the batch identifier at each handoff." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=11;fillColor=#FFFFFF;strokeColor=#7495AE;fontColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="575" y="460" width="510" height="120" /></mxCell><mxCell id="author" value="Madhur Mehta (professorofdata)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry as="geometry" x="890" y="602" width="210" height="22" /></mxCell></root></mxGraphModel></diagram></mxfile>