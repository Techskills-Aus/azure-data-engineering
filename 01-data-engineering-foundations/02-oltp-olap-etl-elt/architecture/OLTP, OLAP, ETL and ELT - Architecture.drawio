<mxfile host="app.diagrams.net"><diagram id="ARCH-201" name="ETL and ELT processing boundaries"><mxGraphModel page="1" pageWidth="1040" pageHeight="570"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" parent="1" vertex="1" value="ETL and ELT processing boundaries" style="text;html=1;align=left;fontSize=25;fontColor=#17394F;"><mxGeometry as="geometry" x="32" y="24" width="976" height="32" /></mxCell><mxCell id="sub" parent="1" vertex="1" value="ARCH-201 | Follow the arrows within each row. Both paths serve the same governed sales measure." style="text;html=1;align=left;fontSize=13;fontColor=#17394F;"><mxGeometry as="geometry" x="32" y="66" width="976" height="32" /></mxCell><mxCell id="heading-0" parent="1" vertex="1" value="ETL · Transform before target load" style="text;html=1;align=left;fontSize=16;fontStyle=1;fontColor=#17394F;"><mxGeometry as="geometry" x="32" y="105" width="975" height="25" /></mxCell><mxCell id="node-0-0" parent="1" vertex="1" value="&lt;b&gt;1. Extract&lt;/b&gt;&lt;br&gt;Read the bounded order and line changes from the operational database." style="rounded=1;html=1;whiteSpace=wrap;align=left;spacing=13;fontSize=15;strokeColor=#779AB2;fillColor=#EAF4FA;"><mxGeometry as="geometry" x="32" y="139" width="305" height="105" /></mxCell><mxCell id="node-0-1" parent="1" vertex="1" value="&lt;b&gt;2. Transform&lt;/b&gt;&lt;br&gt;Filter cancelled orders and calculate net cents in the approved processing boundary." style="rounded=1;html=1;whiteSpace=wrap;align=left;spacing=13;fontSize=15;strokeColor=#779AB2;fillColor=#EAF4FA;"><mxGeometry as="geometry" x="367" y="139" width="305" height="105" /></mxCell><mxCell id="edge-0-1" parent="1" edge="1" source="node-0-0" target="node-0-1" style="html=1;endArrow=block;strokeWidth=3;strokeColor=#17394F;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="node-0-2" parent="1" vertex="1" value="&lt;b&gt;3. Load&lt;/b&gt;&lt;br&gt;Publish the validated order-line fact in the analytical target." style="rounded=1;html=1;whiteSpace=wrap;align=left;spacing=13;fontSize=15;strokeColor=#779AB2;fillColor=#EAF4FA;"><mxGeometry as="geometry" x="702" y="139" width="305" height="105" /></mxCell><mxCell id="edge-0-2" parent="1" edge="1" source="node-0-1" target="node-0-2" style="html=1;endArrow=block;strokeWidth=3;strokeColor=#17394F;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="heading-1" parent="1" vertex="1" value="ELT · Load before target-side transformation" style="text;html=1;align=left;fontSize=16;fontStyle=1;fontColor=#17394F;"><mxGeometry as="geometry" x="32" y="295" width="975" height="25" /></mxCell><mxCell id="node-1-0" parent="1" vertex="1" value="&lt;b&gt;1. Extract&lt;/b&gt;&lt;br&gt;Read the same bounded changes and retain the input counts." style="rounded=1;html=1;whiteSpace=wrap;align=left;spacing=13;fontSize=15;strokeColor=#779AB2;fillColor=#EAF4FA;"><mxGeometry as="geometry" x="32" y="329" width="305" height="105" /></mxCell><mxCell id="node-1-1" parent="1" vertex="1" value="&lt;b&gt;2. Load&lt;/b&gt;&lt;br&gt;Land approved source-shaped records in restricted analytical storage." style="rounded=1;html=1;whiteSpace=wrap;align=left;spacing=13;fontSize=15;strokeColor=#779AB2;fillColor=#EAF4FA;"><mxGeometry as="geometry" x="367" y="329" width="305" height="105" /></mxCell><mxCell id="edge-1-1" parent="1" edge="1" source="node-1-0" target="node-1-1" style="html=1;endArrow=block;strokeWidth=3;strokeColor=#17394F;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="node-1-2" parent="1" vertex="1" value="&lt;b&gt;3. Transform&lt;/b&gt;&lt;br&gt;Apply the business rule on the analytical platform and publish the validated fact." style="rounded=1;html=1;whiteSpace=wrap;align=left;spacing=13;fontSize=15;strokeColor=#779AB2;fillColor=#EAF4FA;"><mxGeometry as="geometry" x="702" y="329" width="305" height="105" /></mxCell><mxCell id="edge-1-2" parent="1" edge="1" source="node-1-1" target="node-1-2" style="html=1;endArrow=block;strokeWidth=3;strokeColor=#17394F;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="check" parent="1" vertex="1" value="Publication check: reconcile scope, accepted line keys, exclusions and regional amounts before exposing results." style="text;html=1;align=left;fontSize=13;fontColor=#17394F;"><mxGeometry as="geometry" x="32" y="500" width="975" height="28" /></mxCell><mxCell id="author" parent="1" vertex="1" value="Madhur Mehta( professorofdata)" style="text;html=1;align=left;fontSize=10;"><mxGeometry as="geometry" x="810" y="540" width="220" height="22" /></mxCell></root></mxGraphModel></diagram></mxfile>