<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram id="basics-1" name="A water pipeline, step by step"><mxGraphModel page="1" pageWidth="960" pageHeight="540"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="A water pipeline, step by step" vertex="1" parent="1" style="text;align=left;fontColor=#163A63;fontSize=28;"><mxGeometry as="geometry" x="36" y="44" width="890" height="42" /></mxCell><mxCell id="subtitle" value="Follow the water from several sources to the people who use it." vertex="1" parent="1" style="text;align=left;fontColor=#163A63;fontSize=14;"><mxGeometry as="geometry" x="36" y="88" width="890" height="24" /></mxCell><mxCell id="n0" value="&lt;b&gt;01 · Collect&lt;/b&gt;&lt;br&gt;Reservoirs, rivers and wells" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF4FB;strokeColor=#286894;fontColor=#163A63;fontSize=14;"><mxGeometry as="geometry" x="36" y="146" width="164" height="89" /></mxCell><mxCell id="n1" value="&lt;b&gt;02 · Move&lt;/b&gt;&lt;br&gt;Intake pipes and pumps" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF4FB;strokeColor=#286894;fontColor=#163A63;fontSize=14;"><mxGeometry as="geometry" x="217" y="146" width="164" height="89" /></mxCell><mxCell id="e1" edge="1" source="n0" target="n1" parent="1" style="endArrow=block;strokeColor=#286894;strokeWidth=2;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="n2" value="&lt;b&gt;03 · Treat&lt;/b&gt;&lt;br&gt;Filter and disinfect" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF4FB;strokeColor=#286894;fontColor=#163A63;fontSize=14;"><mxGeometry as="geometry" x="398" y="146" width="164" height="89" /></mxCell><mxCell id="e2" edge="1" source="n1" target="n2" parent="1" style="endArrow=block;strokeColor=#286894;strokeWidth=2;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="n3" value="&lt;b&gt;04 · Store&lt;/b&gt;&lt;br&gt;Treated water tank" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF4FB;strokeColor=#286894;fontColor=#163A63;fontSize=14;"><mxGeometry as="geometry" x="579" y="146" width="164" height="89" /></mxCell><mxCell id="e3" edge="1" source="n2" target="n3" parent="1" style="endArrow=block;strokeColor=#286894;strokeWidth=2;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="n4" value="&lt;b&gt;05 · Distribute&lt;/b&gt;&lt;br&gt;Homes, shops and schools" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF4FB;strokeColor=#286894;fontColor=#163A63;fontSize=14;"><mxGeometry as="geometry" x="760" y="146" width="164" height="89" /></mxCell><mxCell id="e4" edge="1" source="n3" target="n4" parent="1" style="endArrow=block;strokeColor=#286894;strokeWidth=2;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="note0" value="&lt;b&gt;Keep supply steady&lt;/b&gt;&lt;br&gt;Pumps route water to treatment. The tank holds treated water until people need it." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#F3F8FC;strokeColor=none;fontColor=#163A63;fontSize=13;"><mxGeometry as="geometry" x="36" y="268" width="888" height="54" /></mxCell><mxCell id="note1" value="&lt;b&gt;Check before distribution&lt;/b&gt;&lt;br&gt;Operators test treated water and keep water that fails checks out of the distribution network." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#F3F8FC;strokeColor=none;fontColor=#163A63;fontSize=13;"><mxGeometry as="geometry" x="36" y="335" width="888" height="54" /></mxCell><mxCell id="author" value="Madhur Mehta (professorofdata)" vertex="1" parent="1" style="text;align=right;fontColor=#163A63;fontSize=11;"><mxGeometry as="geometry" x="700" y="494" width="224" height="23" /></mxCell></root></mxGraphModel></diagram><diagram id="basics-2" name="The same idea with data"><mxGraphModel page="1" pageWidth="960" pageHeight="540"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="The same idea with data" vertex="1" parent="1" style="text;align=left;fontColor=#163A63;fontSize=28;"><mxGeometry as="geometry" x="36" y="44" width="890" height="42" /></mxCell><mxCell id="subtitle" value="Follow an order from the source system to a Power BI report." vertex="1" parent="1" style="text;align=left;fontColor=#163A63;fontSize=14;"><mxGeometry as="geometry" x="36" y="88" width="890" height="24" /></mxCell><mxCell id="n0" value="&lt;b&gt;01 · Sources&lt;/b&gt;&lt;br&gt;ERP orders, CSV, carrier API" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF4FB;strokeColor=#286894;fontColor=#163A63;fontSize=14;"><mxGeometry as="geometry" x="36" y="146" width="164" height="89" /></mxCell><mxCell id="n1" value="&lt;b&gt;02 · Ingest&lt;/b&gt;&lt;br&gt;ADF copies or retrieves data" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF4FB;strokeColor=#286894;fontColor=#163A63;fontSize=14;"><mxGeometry as="geometry" x="217" y="146" width="164" height="89" /></mxCell><mxCell id="e1" edge="1" source="n0" target="n1" parent="1" style="endArrow=block;strokeColor=#286894;strokeWidth=2;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="n2" value="&lt;b&gt;03 · Clean&lt;/b&gt;&lt;br&gt;Validate, deduplicate, convert" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF4FB;strokeColor=#286894;fontColor=#163A63;fontSize=14;"><mxGeometry as="geometry" x="398" y="146" width="164" height="89" /></mxCell><mxCell id="e2" edge="1" source="n1" target="n2" parent="1" style="endArrow=block;strokeColor=#286894;strokeWidth=2;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="n3" value="&lt;b&gt;04 · Store&lt;/b&gt;&lt;br&gt;Lakehouse order-line tables" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF4FB;strokeColor=#286894;fontColor=#163A63;fontSize=14;"><mxGeometry as="geometry" x="579" y="146" width="164" height="89" /></mxCell><mxCell id="e3" edge="1" source="n2" target="n3" parent="1" style="endArrow=block;strokeColor=#286894;strokeWidth=2;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="n4" value="&lt;b&gt;05 · Serve&lt;/b&gt;&lt;br&gt;Power BI reports by audience" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF4FB;strokeColor=#286894;fontColor=#163A63;fontSize=14;"><mxGeometry as="geometry" x="760" y="146" width="164" height="89" /></mxCell><mxCell id="e4" edge="1" source="n3" target="n4" parent="1" style="endArrow=block;strokeColor=#286894;strokeWidth=2;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="note0" value="&lt;b&gt;From one source row to a report&lt;/b&gt;&lt;br&gt;Order 00042 enters the raw layer. Its duplicate is removed and the amount is validated before reporting." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#F3F8FC;strokeColor=none;fontColor=#163A63;fontSize=13;"><mxGeometry as="geometry" x="36" y="268" width="888" height="54" /></mxCell><mxCell id="note1" value="&lt;b&gt;Different users, shared definitions&lt;/b&gt;&lt;br&gt;A Power BI semantic model defines Net Sales. Finance sees revenue and operations sees fulfillment metrics." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#F3F8FC;strokeColor=none;fontColor=#163A63;fontSize=13;"><mxGeometry as="geometry" x="36" y="335" width="888" height="54" /></mxCell><mxCell id="author" value="Madhur Mehta (professorofdata)" vertex="1" parent="1" style="text;align=right;fontColor=#163A63;fontSize=11;"><mxGeometry as="geometry" x="700" y="494" width="224" height="23" /></mxCell></root></mxGraphModel></diagram><diagram id="basics-3" name="How the layers work together"><mxGraphModel page="1" pageWidth="960" pageHeight="540"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="How the layers work together" vertex="1" parent="1" style="text;align=left;fontColor=#163A63;fontSize=28;"><mxGeometry as="geometry" x="36" y="44" width="890" height="42" /></mxCell><mxCell id="subtitle" value="An illustrative Azure course design using one order-line pipeline." vertex="1" parent="1" style="text;align=left;fontColor=#163A63;fontSize=14;"><mxGeometry as="geometry" x="36" y="88" width="890" height="24" /></mxCell><mxCell id="n0" value="&lt;b&gt;01 · Source&lt;/b&gt;&lt;br&gt;SQL Server · CSV · REST" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF4FB;strokeColor=#286894;fontColor=#163A63;fontSize=14;"><mxGeometry as="geometry" x="36" y="146" width="164" height="89" /></mxCell><mxCell id="n1" value="&lt;b&gt;02 · Bronze&lt;/b&gt;&lt;br&gt;ADLS Gen2 raw payloads" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF4FB;strokeColor=#286894;fontColor=#163A63;fontSize=14;"><mxGeometry as="geometry" x="217" y="146" width="164" height="89" /></mxCell><mxCell id="e1" edge="1" source="n0" target="n1" parent="1" style="endArrow=block;strokeColor=#286894;strokeWidth=2;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="n2" value="&lt;b&gt;03 · Silver&lt;/b&gt;&lt;br&gt;Typed, validated order lines" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF4FB;strokeColor=#286894;fontColor=#163A63;fontSize=14;"><mxGeometry as="geometry" x="398" y="146" width="164" height="89" /></mxCell><mxCell id="e2" edge="1" source="n1" target="n2" parent="1" style="endArrow=block;strokeColor=#286894;strokeWidth=2;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="n3" value="&lt;b&gt;04 · Gold&lt;/b&gt;&lt;br&gt;Sales and fulfillment tables" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF4FB;strokeColor=#286894;fontColor=#163A63;fontSize=14;"><mxGeometry as="geometry" x="579" y="146" width="164" height="89" /></mxCell><mxCell id="e3" edge="1" source="n2" target="n3" parent="1" style="endArrow=block;strokeColor=#286894;strokeWidth=2;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="n4" value="&lt;b&gt;05 · Serve&lt;/b&gt;&lt;br&gt;Power BI semantic model" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF4FB;strokeColor=#286894;fontColor=#163A63;fontSize=14;"><mxGeometry as="geometry" x="760" y="146" width="164" height="89" /></mxCell><mxCell id="e4" edge="1" source="n3" target="n4" parent="1" style="endArrow=block;strokeColor=#286894;strokeWidth=2;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="note0" value="&lt;b&gt;Orchestration and recovery&lt;/b&gt;&lt;br&gt;Schedule dependencies in ADF. Retry transient errors and advance checkpoints after validation." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#F3F8FC;strokeColor=none;fontColor=#163A63;fontSize=13;"><mxGeometry as="geometry" x="36" y="268" width="888" height="54" /></mxCell><mxCell id="note1" value="&lt;b&gt;Security and governance&lt;/b&gt;&lt;br&gt;Use managed identities, least privilege and encryption in transit and at rest. Apply Power BI row-level security." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#F3F8FC;strokeColor=none;fontColor=#163A63;fontSize=13;"><mxGeometry as="geometry" x="36" y="335" width="888" height="54" /></mxCell><mxCell id="note2" value="&lt;b&gt;Monitoring and data quality&lt;/b&gt;&lt;br&gt;Track run IDs, freshness, counts and rejected rows. Alert on failures and reconcile totals before publishing." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#F3F8FC;strokeColor=none;fontColor=#163A63;fontSize=13;"><mxGeometry as="geometry" x="36" y="402" width="888" height="54" /></mxCell><mxCell id="author" value="Madhur Mehta (professorofdata)" vertex="1" parent="1" style="text;align=right;fontColor=#163A63;fontSize=11;"><mxGeometry as="geometry" x="700" y="494" width="224" height="23" /></mxCell></root></mxGraphModel></diagram></mxfile>